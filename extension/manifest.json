{
  "manifest_version": 3,
  "name": "百度翻译 · 简净",
  "version": "1.1.7",
  "description": "精简百度翻译的文本、文档和图片工作区，提供深色模式和紧凑工具栏。",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["icons/ai-outline.png"],
    "matches": ["https://fanyi.baidu.com/*"]
  }],
  "content_scripts": [{
    "matches": ["https://fanyi.baidu.com/mtpe-individual/*"],
    "js": ["language-names.js", "focus.js"],
    "css": ["icons.css", "focus.css", "media.css", "language-menu.css", "collection.css"],
    "run_at": "document_start"
  }, {
    "matches": ["https://fanyi.baidu.com/mtpe-individual/*"],
    "js": ["collect.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }]
}
